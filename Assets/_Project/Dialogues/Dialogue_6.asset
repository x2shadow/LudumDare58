  lines:
  - speaker: 0
    text: "\u0414\u0438\u0430\u043B\u043E\u0433 6: \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
      \u0438\u0433\u0440\u0430. \u0418\u043B\u0438 \u043F\u0435\u0440\u0432\u0430\u044F?
      \u042F \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E. \u041D\u0435\u0432\u0430\u0436\u043D\u043E.
      \u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u2014 \u044D\u0442\u043E \u0432\u0441\u0435,
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C"
